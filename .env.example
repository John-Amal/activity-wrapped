# Copy to .env and fill in. Register an API application at
# https://www.strava.com/settings/api with:
#   Website:                        http://localhost:8000
#   Authorization Callback Domain:  localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where the app is served; the OAuth redirect is BASE_URL/auth/callback.
BASE_URL=http://localhost:8000

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Local cache for fetched activity details (best efforts only).
CACHE_DIR=.cache
